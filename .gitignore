# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtualenvs
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.pip-audit-cache/
.cache/
.coverage
htmlcov/
audit-requirements.txt

# Local runtime state
*.log
*.pid

# Local configuration and private key material
.env
.env.*
!.env.example
!/deploy/.env.production.example
*.key
*.pem
*.p12
*.pfx

# Generated reports (may contain sensitive subject data — keep out of git)
/reports/*
!/reports/.gitkeep

# Local databases (investigation data — keep out of git)
*.db
*.db-wal
*.db-shm
/data/*.db

# Fetched WhatsMyName dataset (opt-in via scripts/fetch_wmn.py; CC BY 4.0, large)
/data/

# Local API-key vault (never commit secrets)
keys.toml

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Production secret material
/deploy/secrets/*
!/deploy/secrets/*.example
/backups/*
!/backups/.gitkeep
